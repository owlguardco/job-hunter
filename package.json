{
  "name": "job-hunter",
  "version": "1.4.0",
  "description": "AI-powered job search toolkit \u2014 resume tailoring, ATS scanner, interview prep, offer negotiation, and career growth tools",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "guide": "node scripts/guide.js",
    "reality-check": "node scripts/preflight.js resume && claude --print \"$(cat agents/apply-reality-check.md)\"",
    "fit": "node scripts/preflight.js resume && claude --print \"$(cat agents/apply-fit-score.md)\"",
    "linkedin": "node scripts/preflight.js linkedin && claude --print \"$(cat agents/apply-linkedin-audit.md)\"",
    "portfolio": "node scripts/preflight.js resume && claude \"follow agents/apply-portfolio-brief.md\"",
    "resume": "node scripts/preflight.js resume && claude --print \"$(cat agents/apply-resume.md)\"",
    "cover-letter": "node scripts/preflight.js cover-letter && claude --print \"$(cat agents/apply-cover-letter.md)\"",
    "ats": "node scripts/preflight.js resume && claude --print \"$(cat agents/apply-ats-scan.md)\"",
    "bias-audit": "node scripts/preflight.js resume && claude \"follow agents/apply-bias-audit.md\"",
    "rejection": "node scripts/preflight.js resume && claude \"follow agents/apply-rejection-analysis.md\"",
    "references": "node scripts/preflight.js resume && claude \"follow agents/apply-reference-prep.md\"",
    "decode": "node scripts/preflight.js resume && claude --print \"$(cat agents/apply-decode-jd.md)\"",
    "linkedin-scrape": "claude \"follow agents/apply-linkedin-scrape.md\"",
    "jobs": "node scripts/preflight.js all && claude \"follow agents/search-jobs.md\"",
    "salary": "node scripts/preflight.js resume && claude --print \"$(cat agents/search-salary.md)\"",
    "company": "node scripts/preflight.js resume && claude \"follow agents/search-company-research.md\"",
    "referrals": "node scripts/preflight.js resume && claude \"follow agents/search-referral-finder.md\"",
    "follow-up": "node scripts/preflight.js resume && claude \"follow agents/search-follow-up.md\"",
    "outreach": "node scripts/preflight.js resume && claude \"follow agents/search-outreach.md\"",
    "inbox": "node scripts/preflight.js resume && claude \"follow agents/search-inbox-scan.md\"",
    "tracker": "claude \"follow agents/search-tracker-update.md\"",
    "send-email": "claude \"follow agents/search-send-email.md\"",
    "interview": "node scripts/preflight.js interview && claude --print \"$(cat agents/interview-prep.md)\"",
    "mock": "node scripts/preflight.js interview && claude \"follow agents/interview-mock.md\"",
    "debrief": "node scripts/preflight.js resume && claude \"follow agents/interview-debrief.md\"",
    "questions": "node scripts/preflight.js resume && claude \"follow agents/interview-question-bank.md\"",
    "research": "node scripts/preflight.js interview && claude \"follow agents/interview-research.md\"",
    "negotiate": "node scripts/preflight.js resume && claude \"follow agents/offer-negotiate.md\"",
    "counter": "node scripts/preflight.js resume && claude \"follow agents/offer-counteroffer.md\"",
    "deadline": "node scripts/preflight.js resume && claude \"follow agents/offer-deadline-manager.md\"",
    "compare": "node scripts/preflight.js resume && claude \"follow agents/offer-compare.md\"",
    "schedule": "node scripts/preflight.js interview && claude \"follow agents/offer-schedule.md\"",
    "send-thankyou": "node scripts/preflight.js interview && claude \"follow agents/offer-thankyou.md\"",
    "promote": "node scripts/preflight.js resume && claude \"follow agents/career-promote.md\"",
    "review": "node scripts/preflight.js resume && claude \"follow agents/career-review.md\"",
    "internal": "node scripts/preflight.js resume && claude \"follow agents/career-internal.md\"",
    "network": "node scripts/preflight.js resume && claude \"follow agents/career-network-message.md\"",
    "linkedin-post": "node scripts/preflight.js resume && claude \"follow agents/career-linkedin-content.md\"",
    "commercial": "START_COMMERCIAL=true node start.js",
    "commercial:dev": "START_COMMERCIAL=true node --watch start.js",
    "db:migrate": "node commercial/db/migrate.js",
    "daily-search": "python3.11 scripts/job-search.py && claude --dangerously-skip-permissions \"follow automation/pipeline-daily-search.md\"",
    "interview-auto": "claude --dangerously-skip-permissions \"follow automation/pipeline-interview-prep.md\"",
    "check": "node scripts/preflight.js all"
  },
  "dependencies": {
    "mem0ai": "^2.1.0",
    "pg": "^8.11.3",
    "dotenv": "^16.4.5",
    "svix": "^1.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}