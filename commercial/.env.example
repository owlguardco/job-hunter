# Anthropic — your key, users don't need their own
ANTHROPIC_API_KEY=sk-ant-

# Clerk — auth
CLERK_SECRET_KEY=sk_live_
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_WEBHOOK_SECRET=whsec_   # from Clerk dashboard → Webhooks → signing secret

# Whop — marketplace billing (get from whop.com/developer)
WHOP_API_KEY=            # whop developer API key
WHOP_WEBHOOK_SECRET=     # from Whop developer settings → webhooks
WHOP_PLAN_STARTER=       # plan_xxxx — $5/25 runs
WHOP_PLAN_PRO=           # plan_xxxx — $15/100 runs
WHOP_PLAN_MONTHLY=       # plan_xxxx — $19/month unlimited

# Stripe — billing (keep for direct jobhunter.ai purchases)
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_MONTHLY=price_

# Mem0 — persistent user memory (get key at app.mem0.ai)
MEM0_API_KEY=m0-

# Database (Railway Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# LinkedIn (for admin dashboard posting)
LINKEDIN_ACCESS_TOKEN=       # from LinkedIn Developer app OAuth
LINKEDIN_AUTHOR_URN=         # urn:li:person:YOUR_ID

# Admin (set your Clerk user ID to grant admin access)
ADMIN_USER_ID=               # your Clerk user_xxx ID

# App
PORT=3001
APP_URL=https://jobhunter.ai
